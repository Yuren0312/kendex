#!/usr/bin/env bash
# The public session boundary; the Python owner keeps lifecycle state.
set -euo pipefail
SCRIPT_DIR="$(cd -- "${BASH_SOURCE[0]%/*}" && pwd -P)"
OWNER="$SCRIPT_DIR/../../orch/scripts/controller-session"
[[ -x "$OWNER" ]] || { printf 'jarvis-session: dependency=orch\n' >&2; exit 2; }
exec "$OWNER" "$@"
